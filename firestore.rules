rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cuenta del usuario: perfil básico, chats guardados, plan, etc.
    // (todo lo que ya escriben home.html, chats.html, perfil.html, pago.html...)
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Respuestas crudas del onboarding (gemelo-setup.html).
      match /gemelo_setup/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Chats guardados por persona (chats.html, matches.html, home.html).
      // Antes eran campos sueltos chats_{id}_{modo} / leido_{id}_{modo} en
      // este mismo doc; ahora cada conversación es un doc propio acá. El chat
      // con el propio gemelo (gemelo.html) vive acá también, en el doc de id
      // fijo "gemelo_propio" -- no es una conversación con otra persona, así
      // que no tiene modos real/gemelo, solo un log.
      match /chats/{personaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Perfil normalizado del gemelo: lo genera SOLO la Cloud Function
      // (generar_perfil_gemelo, vía Admin SDK) a partir del onboarding.
      // El cliente lo puede leer para mostrarlo, pero nunca escribirlo --
      // si no, cualquiera podría inventarse rasgos falsos para matchear mejor.
      match /gemelo/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Conexión entre dos usuarios: identidad de la pareja + resultado de las
    // simulaciones (usuario_1/usuario_2/ultimo_score/supera_umbral/distancia_km,
    // que solo escribe la Cloud Function vía Admin SDK) + el chat entre ellos
    // (real/gemelo, que sí escriben los propios usuarios desde chats.html).
    //
    // Antes cada usuario tenía su propia copia de cada chat en
    // usuarios/{uid}/chats/{personaId} -- ahora es un solo doc compartido acá,
    // con id = par_id (mismo esquema que ya usaba motor._par_id en el backend).
    //
    // "participantes" (array [uid1, uid2]) existe SOLO para que las reglas y
    // las queries de lista puedan comprobar "soy parte de esta conexión" con
    // una condición sola (array-contains / in), no un OR entre usuario_1.uid
    // y usuario_2.uid -- probado con el emulador: ese OR (comparando dos
    // campos distintos) hace que Firestore rechace con PERMISSION_DENIED
    // cualquier query que solo filtre por uno de los dos, aunque los datos
    // estén bien. Es una limitación real y documentada de Firestore con
    // queries de lista + reglas con OR entre campos, no algo que se pueda
    // evitar reescribiendo la regla de otra forma.
    match /conexiones/{parId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantes;

      // Un usuario puede crear la conexión si todavía no existe (ej: le
      // escribe a alguien antes de que corriera ninguna simulación) -- pero
      // solo puede setear su identidad y el chat, nunca los campos de score
      // (esos SIEMPRE los pone la Cloud Function, create o merge posterior).
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantes &&
        request.resource.data.keys().hasOnly(['usuario_1', 'usuario_2', 'participantes', 'real', 'gemelo']);

      // Para actualizar una conexión ya existente, un usuario de la pareja
      // solo puede tocar los campos de chat -- nunca el score, la pareja, ni
      // la lista de participantes.
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantes &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['real', 'gemelo']);

      allow delete: if false;

      match /simulaciones/{simId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conexiones/$(parId)).data.participantes;
        allow write: if false;
      }
    }

    // Cola de parejas por evaluar (buscar_parejas_pendientes /
    // procesar_parejas_pendientes, ambas scheduled functions). Nadie del
    // cliente necesita leerla ni escribirla todavía -- es un detalle interno
    // del batch nocturno.
    match /parejas_pendientes/{parId} {
      allow read, write: if false;
    }

    // Waitlist pre-registro de index.html (todavía sin cuenta creada).
    match /beta_waitlist/{emailId} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
